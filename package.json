{
  "name": "hms-platform",
  "private": true,
  "description": "Healthcare management monorepo — orchestration scripts",
  "scripts": {
    "prepare": "bash scripts/hms-prepare.sh",
    "reset": "bash scripts/hms-reset.sh",
